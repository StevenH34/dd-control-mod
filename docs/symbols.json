  "comments": [
    {"address": "1002dab0", "type": "PLATE", "text": "Sets CAM tunables (min/max dist 900/1500, pitch) and camobj+0x18 = Camera_Update."},
    {"address": "1002e5c0", "type": "PLATE", "text": "Clamp dist [min,max] and pitch; max slope hard-coded 0x1126."},
    {"address": "1002e950", "type": "PLATE", "text": "Camera move capped at 0x6e units/frame."},
    {"address": "1002f310", "type": "PLATE", "text": "Mode 3: follow while visible, else reposition."},
    {"address": "1002f570", "type": "PLATE", "text": "GENERAL_UP/DOWN/LEFT/RIGHT actions -> look deltas."},
    {"address": "1002f750", "type": "PLATE", "text": "Random spot ~768 out, 450-550 up, same side."},
    {"address": "1002f8e0", "type": "PLATE", "text": "([0x10104644] alt/free cam, [0x10104640] pre-hook)"},
    {"address": "10030120", "type": "PLATE", "text": "Highest-priority authored camera zone for player sector. Return 0 to disable fixed cams."},
    {"address": "10030d30", "type": "PLATE", "text": "Look-at = player pos, y+100 (~300 above floor on ledges)."},
    {"address": "10030e30", "type": "PLATE", "text": "Per frame: pre-hook (player controls) -> target -> mode solve loop -> apply."},
    {"address": "10030f10", "type": "PLATE", "text": "Zone check, then mode handler (+0x27c: 3 chase, 4 1st person, 5 snap)."},
    {"address": "10031270", "type": "PLATE", "text": "Pitch +-200, yaw +-300 relative to body."},
    {"address": "10050f50", "type": "PLATE", "text": "DirectInput GetDeviceState(256) -> 256-bit key mask. Letters A-Z remapped to 0x80-0x99."},
    {"address": "1005dad0", "type": "PLATE", "text": "Loads user keys.cfg (falls back to copying asylum\\keys.cfg)."},
    {"address": "1005dc40", "type": "PLATE", "text": "Per frame: sample mouse/joystick, evaluate every action into g_ActionState[id]."},
    {"address": "1005dca0", "type": "PLATE", "text": "Action_Get(id, &value, &isAnalog)."},
    {"address": "1005dd00", "type": "PLATE", "text": "Returns action value (0x4000 digital, magnitude analog) or 0 if inactive."},
    {"address": "1005de40", "type": "PLATE", "text": "DOWN=1 PRESS=2 RELEASE=3."},
    {"address": "1005dfb0", "type": "PLATE", "text": "Parses: define ACTION_X DOWN|PRESS|RELEASE SRC + SRC ..."},
    {"address": "1005e810", "type": "PLATE", "text": "Dispatch on source type: 1 key, 2 mouse, 3 joystick."},
    {"address": "10068710", "type": "PLATE", "text": "Turn on spot, anims 2/3, +-0x20 yaw/frame."},
    {"address": "10068a30", "type": "PLATE", "text": "Fast turn, anims 4/5, +-0x40 yaw/frame."},
    {"address": "10069670", "type": "PLATE", "text": "Installed as camera pre-hook; calls Controller_Dispatch(player)."},
    {"address": "100697c0", "type": "PLATE", "text": "Per frame: g_KeysDown = Kbd_Poll(); g_KeysChanged = old ^ new."},
    {"address": "10082840", "type": "PLATE", "text": "*(actor+0x114)+0x144 & mask"},
    {"address": "10082860", "type": "PLATE", "text": "*(actor+0x114)+0x144 |= bits"},
    {"address": "10082880", "type": "PLATE", "text": "*(actor+0x114)+0x148 = rate"},
    {"address": "100871b0", "type": "PLATE", "text": "TANK CONTROLS. Actions -> command bits (ctl+0x144) and turn rate (ctl+0x148). Main movement patch target."},
    {"address": "100878d0", "type": "PLATE", "text": "Control_Update + 1st-person / camera-type / render-mode actions."},
    {"address": "10098460", "type": "PLATE", "text": "Reads recorded key mask + mouse from demo file."}
  ]
